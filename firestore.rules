rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Anyone can sign up as an organizer, but only accounts approved in the
    // Firebase console (organizerApproved: true) can create events.
    function isOrganizer() {
      return isSignedIn() &&
        exists(currentUserPath()) &&
        get(currentUserPath()).data.get('organizerApproved', false) == true &&
        (
          get(currentUserPath()).data.role == 'Organizer' ||
          get(currentUserPath()).data.isOrganizer == true ||
          (
            get(currentUserPath()).data.roles is list &&
            get(currentUserPath()).data.roles.hasAny(['Organizer'])
          )
        );
    }

    // Attendance can be marked from the event start through 2 days after, by server time.
    // Events without a timestamp date cannot be checked in.
    function eventAttendanceOpen(eventData) {
      return (
        eventData.get('eventDate', null) is timestamp &&
        request.time >= eventData.eventDate &&
        request.time <= eventData.eventDate + duration.value(2, 'd')
      ) || (
        eventData.get('date', null) is timestamp &&
        request.time >= eventData.date &&
        request.time <= eventData.date + duration.value(2, 'd')
      ) || (
        eventData.get('startDate', null) is timestamp &&
        request.time >= eventData.startDate &&
        request.time <= eventData.startDate + duration.value(2, 'd')
      );
    }

    function eventDeleteOpen(eventData) {
      return (
        eventData.eventDate is timestamp &&
        request.time < eventData.eventDate - duration.value(12, 'h')
      ) || (
        eventData.date is timestamp &&
        request.time < eventData.date - duration.value(12, 'h')
      ) || (
        eventData.startDate is timestamp &&
        request.time < eventData.startDate - duration.value(12, 'h')
      ) || (
        !(eventData.eventDate is timestamp) &&
        !(eventData.date is timestamp) &&
        !(eventData.startDate is timestamp)
      );
    }

    function pointFields() {
      return ['impactPoints', 'totalPoints', 'rewardPoints', 'points'];
    }

    // Same fallback order the app uses when reading points.
    function pointsOf(data) {
      return data.get('impactPoints',
        data.get('totalPoints',
          data.get('rewardPoints',
            data.get('points', 0))));
    }

    function eventPointsOf(data) {
      return data.get('impactPoints', data.get('points', data.get('rewardPoints', 0)));
    }

    function ownerIdsOf(data) {
      return [
        data.get('createdByUid', ''),
        data.get('organizerId', ''),
        data.get('userId', ''),
        data.get('ownerId', '')
      ];
    }

    function pointsChangedFrom(beforeData) {
      return request.resource.data.diff(beforeData).affectedKeys().hasAny(pointFields());
    }

    function arePointFieldsAligned() {
      return request.resource.data.impactPoints == request.resource.data.totalPoints &&
        request.resource.data.totalPoints == request.resource.data.rewardPoints &&
        request.resource.data.rewardPoints == request.resource.data.points;
    }

    // An organizer may change another user's points only together with that user's award
    // on an event the organizer owns, in the same transaction, by exactly the event's points.
    function isEventOrganizerAttendanceWrite(userId, beforeData) {
      let after = request.resource.data;
      let eventId = after.get('attendanceEventId', '');
      let eventPath = /databases/$(database)/documents/events/$(eventId);
      let eventBefore = get(eventPath).data;
      let eventAfter = getAfter(eventPath).data;
      let impact = eventPointsOf(eventAfter);
      let wasAwarded = userId in eventBefore.get('awardedParticipantIds', []);
      let isAwarded = userId in eventAfter.get('awardedParticipantIds', []);
      let oldPts = pointsOf(beforeData);
      let newPts = pointsOf(after);
      return isSignedIn() &&
        userId != request.auth.uid &&
        request.auth.uid in ownerIdsOf(eventAfter) &&
        after.diff(beforeData).affectedKeys().hasOnly(pointFields().concat([
          'participationStatusByEvent',
          'attendanceVerifiedAtByEvent',
          'attendanceEventId',
          'updatedAt'
        ])) &&
        after.get('participationStatusByEvent', {})
          .diff(beforeData.get('participationStatusByEvent', {})).affectedKeys().hasOnly([eventId]) &&
        after.get('attendanceVerifiedAtByEvent', {})
          .diff(beforeData.get('attendanceVerifiedAtByEvent', {})).affectedKeys().hasOnly([eventId]) &&
        (!pointsChangedFrom(beforeData) || arePointFieldsAligned()) &&
        (
          (wasAwarded == isAwarded && newPts == oldPts) ||
          (!wasAwarded && isAwarded && newPts == oldPts + impact) ||
          (wasAwarded && !isAwarded && newPts == (oldPts > impact ? oldPts - impact : 0))
        );
    }

    match /users/{userId} {
      // Anyone can read user docs.
      allow read: if true;

      // Users start with no points and can only lower their own (leaving an event reverses its points).
      // Users can never approve themselves as organizers.
      allow create: if (
          isOwner(userId) &&
          !request.resource.data.keys().hasAny(pointFields().concat(['organizerApproved']))
        ) ||
        isEventOrganizerAttendanceWrite(userId, {});
      allow update: if (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizerApproved']) &&
          (
            !pointsChangedFrom(resource.data) ||
            (arePointFieldsAligned() && pointsOf(request.resource.data) <= pointsOf(resource.data))
          )
        ) ||
        isEventOrganizerAttendanceWrite(userId, resource.data);
      allow delete: if false;
    }

    match /user_profiles/{userId} {
      // Anyone can read user_profile docs.
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /user_lookup/{userId} {
      // Anyone can read lightweight lookup docs.
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /posts/{postId} {
      // Anyone can read public posts.
      allow read: if true;

      // Users can create posts for themselves only.
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'postId',
          'authorUid',
          'authorName',
          'authorBio',
          'authorPhotoUrl',
          'description',
          'imageUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.postId == postId;

      // Users can update/delete only their own posts.
      allow update, delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;

      match /likes/{userId} {
        // Anyone can read likes.
        allow read: if true;

        // Users can like/unlike only as themselves.
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == userId;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /comments/{commentId} {
        // Anyone can read comments.
        allow read: if true;

        // Users can create comments only as themselves.
        allow create: if isSignedIn() &&
          request.resource.data.keys().hasOnly([
            'commentId',
            'uid',
            'authorName',
            'authorPhotoUrl',
            'text',
            'createdAt',
            'updatedAt'
          ]) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.commentId == commentId;

        // Users can update/delete their own comments only.
        allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }

    match /events/{eventId} {
      // Legacy events may store the creator under an older field name.
      function isEventOwner() {
        return isSignedIn() && request.auth.uid in ownerIdsOf(resource.data);
      }

      // Matches the 50-200 range the app enforces.
      function impactPointsValid() {
        let p = request.resource.data.get('impactPoints', 0);
        return p is int && p >= 50 && p <= 200;
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function idsBefore(field) {
        return resource.data.get(field, []).toSet();
      }

      function idsAfter(field) {
        return request.resource.data.get(field, []).toSet();
      }

      // The caller may only remove themselves from this list, never add anyone.
      function onlySelfRemoved(field) {
        return idsBefore(field).hasAll(idsAfter(field)) &&
          idsBefore(field).difference(idsAfter(field)).hasOnly([request.auth.uid]);
      }

      // Anyone can read event docs.
      allow read: if true;

      // Organizers create events as themselves.
      allow create: if isOrganizer() &&
        request.resource.data.createdByUid == request.auth.uid &&
        impactPointsValid();

      // Volunteers can join/leave only as themselves; leaving also drops their own check-in.
      allow update: if isSignedIn() &&
        changedKeys().hasOnly(['participantIds', 'participantsCount', 'checkedInIds', 'awardedParticipantIds', 'updatedAt']) &&
        idsBefore('participantIds').difference(idsAfter('participantIds'))
          .union(idsAfter('participantIds').difference(idsBefore('participantIds')))
          .hasOnly([request.auth.uid]) &&
        request.resource.data.participantsCount == request.resource.data.participantIds.size() &&
        onlySelfRemoved('checkedInIds') &&
        onlySelfRemoved('awardedParticipantIds');

      // Only the event's own organizer can mark attendance or award points, only for joined
      // volunteers other than themselves, within the window.
      allow update: if isEventOwner() &&
        changedKeys().hasOnly(['checkedInIds', 'awardedParticipantIds', 'updatedAt']) &&
        idsAfter('checkedInIds').difference(idsBefore('participantIds')).size() == 0 &&
        idsAfter('awardedParticipantIds').difference(idsBefore('participantIds')).size() == 0 &&
        !idsAfter('checkedInIds').difference(idsBefore('checkedInIds')).hasAny([request.auth.uid]) &&
        eventAttendanceOpen(resource.data);

      // The event's own organizer can edit details, but not attendance, participants or ownership.
      // Points are frozen once anyone is awarded, so re-checking can't inflate totals.
      allow update: if isEventOwner() &&
        !changedKeys().hasAny(['checkedInIds', 'awardedParticipantIds', 'participantIds', 'participantsCount', 'createdByUid']) &&
        (
          !changedKeys().hasAny(['impactPoints', 'points', 'rewardPoints']) ||
          (impactPointsValid() && idsBefore('awardedParticipantIds').size() == 0)
        );

      allow delete: if isEventOwner() && eventDeleteOpen(resource.data);

      match /likes/{userId} {
        // Anyone can read likes.
        allow read: if true;

        // Users can create/delete only their own like doc with constrained fields.
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == userId;
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }
  }
}
